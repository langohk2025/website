{
  "name": "lango-ai-clone",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "build:static": "next build",
    "serve:static": "npx serve out -p 3000",
    "dev:full": "npm run build && wrangler pages dev out --d1 DB=lango-website-db --port 8788",
    "db:migrate:local": "wrangler d1 migrations apply lango-website-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply lango-website-db --remote",
    "db:migrate:preview": "wrangler d1 migrations apply lango-website-db-preview --remote --env preview",
    "sanity:dev": "sanity dev",
    "sanity:deploy": "sanity deploy",
    "sanity:seed": "node scripts/seed-sanity-news.mjs",
    "sanity:sync-linkedin": "node scripts/sync-linkedin-news.mjs",
    "deploy": "npm run build && wrangler pages deploy out --project-name=lango-website"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.0.0",
    "@fortawesome/free-brands-svg-icons": "^7.0.0",
    "@fortawesome/react-fontawesome": "^0.2.3",
    "@next/third-parties": "^15.4.5",
    "@portabletext/react": "^3.2.1",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.12",
    "@sanity/client": "^7.8.0",
    "@sanity/image-url": "^1.1.0",
    "@sanity/vision": "^4.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.11",
    "lucide-react": "^0.532.0",
    "next": "15.4.4",
    "radix-ui": "^1.4.2",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "sanity": "^4.7.0",
    "styled-components": "^6.4.4",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260727.0",
    "@eslint/eslintrc": "^3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.21",
    "eslint": "^9",
    "eslint-config-next": "15.4.4",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "5.9.2",
    "wrangler": "^4.114.0"
  }
}
