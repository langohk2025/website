# ── Local Next.js build (copy to `.env.local`) ────────────────────────────────
#
# test.lango.ai  → Cloudflare Pages "Preview" environment
# lango.ai       → Cloudflare Pages "Production" environment
#
# Same codebase; only env vars differ per environment in the Cloudflare dashboard.
# No code changes needed when promoting test → production.

# Resend (contact form emails)
RESEND_API_KEY=

# Preview:  CONTACT_EMAIL_TO=you@yourteam.com   (optional — avoid spamming info@ during testing)
# Production: CONTACT_EMAIL_TO=info@lango.ai
CONTACT_EMAIL_TO=info@lango.ai
CONTACT_EMAIL_FROM=Lango Website <noreply@lango.ai>

# Admin panel (/admin) — use different passwords for Preview vs Production
ADMIN_PASSWORD=

# Sanity CMS (news) — Phase 2
NEXT_PUBLIC_SANITY_PROJECT_ID=
# Preview: development   |   Production: production
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01
# Editor token for `npm run sanity:seed` and build-time fetch (if dataset is private)
SANITY_API_TOKEN=

# Hosted Sanity Studio URL (after `npm run sanity:deploy`)
NEXT_PUBLIC_SANITY_STUDIO_URL=https://lango-website.sanity.studio

# Phase 2 setup (run once after creating Sanity project):
#   1. Fill vars above in .env.local
#   2. npm run sanity:deploy
#   3. npm run sanity:seed
#   4. Add NEXT_PUBLIC_SANITY_* to Cloudflare Pages build env
#   5. Sanity → API → Webhooks → POST Cloudflare Pages deploy hook on publish

# Daily LinkedIn → Sanity sync (npm run sanity:sync-linkedin / GitHub Actions)
# LINKEDIN_COMPANY_SLUG=lango-language
# LINKEDIN_SYNC_PUBLISH=true
# LINKEDIN_SYNC_MAX=10
# CLOUDFLARE_PAGES_DEPLOY_HOOK_URL=   # Pages → Settings → Builds → Deploy hooks
#
# GitHub repo secrets required for .github/workflows/sync-linkedin-news.yml:
#   NEXT_PUBLIC_SANITY_PROJECT_ID
#   NEXT_PUBLIC_SANITY_DATASET
#   SANITY_API_TOKEN
#   CLOUDFLARE_PAGES_DEPLOY_HOOK_URL  (so /news rebuilds after new posts)
